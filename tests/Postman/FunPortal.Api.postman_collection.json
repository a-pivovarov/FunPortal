                    "type": "text/javascript",
                    "exec": [
                      "const token = pm.response.json();\r\n\r\npm.test(\"Has properties\", function () {\r\n    pm.expect(token).to.have.property('accessToken');\r\n    pm.expect(token).to.have.property('refreshToken');\r\n});\r\n\r\nif (pm.test(\"Has properties\")) {\r\n    pm.collectionVariables.set('accessToken', token.accessToken);\r\n}"
