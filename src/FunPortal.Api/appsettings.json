{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=funportal.db"
  },
  "JwtSettings": {
    "Issuer": "FunPortalAPI",
    "Audience": "FunPortalClient",
    "SecretKey": "YourVerySecureSecretKeyThatIsAtLeast32CharactersLongForHS256Algorithm!",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
